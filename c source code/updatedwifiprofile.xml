<?xml version="1.0" encoding="utf-8"?>
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
    <name>NJ MGMT</name>
    <SSIDConfig>
        <SSID>
            <name>NJ MGMT</name> <!-- WiFi SSID -->
        </SSID>
    </SSIDConfig>
    <connectionType>ESS</connectionType>
    <connectionMode>auto</connectionMode>
    <MSM>
        <security>
            <authEncryption>
                <authentication>WPA2PSK</authentication> <!-- WPA2 PSK Authentication -->
                <encryption>AES</encryption> <!-- AES Encryption -->
                <useOneX>false</useOneX> <!-- Disable 802.1X Authentication -->
            </authEncryption>
            <sharedKey>
                <keyType>passPhrase</keyType> <!-- Passphrase for WPA2 -->
                <protected>false</protected> <!-- Plaintext password -->
                <keyMaterial>N^uf0nE@tib8</keyMaterial> <!-- Replace with your WiFi password -->
            </sharedKey>
        </security>
    </MSM>
</WLANProfile>